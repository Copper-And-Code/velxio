// Copper-And-Code/velxio in GitHub Codespaces (or any devcontainer host):
// the backend (FastAPI + Renode for the STM32H743 Core, the QEMU builds for
// the ESP32 family and the RP2350, arduino-cli for the AVR boards) and the
// Vite frontend, started together. Open the forwarded port 5173 ("Velxio").
//
// What runs here: the three panel boards (STM32H743 Core, ESP32-4848S040,
// Waveshare RP2350-Touch-LCD-4), the ESP32 family, Arduino Uno/Nano/Mega and
// ATtiny85, Raspberry Pi Pico, circuits. The binaries come from
// scripts/fetch-prebuilt.sh (docs/BUILD-QEMU.md).
{
  "name": "Velxio (Copper and Code fork)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  // Renode runs one emulated STM32H743 per Run: 4 cores keep it near real time.
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [5173, 8001],
  "portsAttributes": {
    "5173": { "label": "Velxio", "onAutoForward": "openBrowser" },
    "8001": { "label": "Backend API", "onAutoForward": "silent" }
  },
  "customizations": {
    "codespaces": { "openFiles": [".devcontainer/README.md"] }
  }
}
