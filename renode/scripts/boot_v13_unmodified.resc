:name: STM32H7_CORE V13 unmodified firmware boot
:description: Load existing firmware.elf to identify stall point. REPL on USART1 (PA9/PA10).

$bin?=@/opt/github/lv_micropython/ports/stm32/build-STM32H7_CORE-V13/firmware.elf

mach create "h743_core_v13"
machine LoadPlatformDescription @/opt/github/velxio/renode/platforms/stm32h7_core_v13.repl

# UART REPL (USART1 PA9/PA10) → terminale Renode
showAnalyzer sysbus.usart1

# Logging utile per il primo bring-up
logLevel 3
logLevel -1 sysbus.usart1
sysbus LogPeripheralAccess sysbus.fmc true
sysbus LogPeripheralAccess sysbus.rcc true

# Carica il firmware e imposta il PC dal vector table
sysbus LoadELF $bin

# Il reset handler imposta SP/PC dal vector table @ 0x08000000 — niente da fare a mano.
echo "Pronto. Esegui 'start' per avviare la CPU."
