:name: STM32H7_CORE V13 boot test headless
:description: Headless boot test of unmodified firmware to identify stall point.

$bin?=@/opt/github/lv_micropython/ports/stm32/build-STM32H7_CORE-V13/firmware.elf
$uartlog?=@/opt/github/velxio/renode/logs/uart.log

using sysbus
mach create "h743_core_v13"
machine LoadPlatformDescription @/opt/github/velxio/renode/platforms/stm32h7_core_v13.repl

# Logging
logLevel 3
logFile @/opt/github/velxio/renode/logs/renode.log true
logLevel -1 sysbus.usart1

# USART1 redirect to file (headless)
sysbus.usart1 CreateFileBackend $uartlog true

# Reset macro: sets vector table base then loads firmware (re-runs on every reset)
macro reset
"""
    cpu VectorTableOffset 0x08000000
    sysbus LoadELF $bin
"""
runMacro $reset

# Run for 5 seconds of emulated time, then exit
emulation RunFor "00:00:05"

# State at end
sysbus.cpu0 PC
sysbus.cpu0 IsHalted

quit
